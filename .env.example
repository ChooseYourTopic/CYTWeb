# CYTWeb environment — copy to .env.local for local dev.
# All NEXT_PUBLIC_* vars are inlined at build time and are public.

# CYTAPI base origin (no trailing slash). Client calls ${NEXT_PUBLIC_API_URL}/api/v1
NEXT_PUBLIC_API_URL=http://localhost:8000

# WebSocket origin for the live activity feed. Client connects to ${NEXT_PUBLIC_WS_URL}/ws/activity
# In production behind nginx/TLS this must be a wss:// origin.
NEXT_PUBLIC_WS_URL=ws://localhost:8000

# X-API-Key sent on every REST request.
NEXT_PUBLIC_API_KEY=dev-key

# --- Internal Winslow status board (/preview/status + /preview/releases) ---
# These are RUNTIME (server-side) env, NOT build-time NEXT_PUBLIC_* — pass them
# via `docker run -e` (or the runtime env), and mount the data dir into the
# container. The pages read these files at REQUEST time (force-dynamic), so
# editing the JSON on the box updates the board with NO redeploy. If unset the
# loader defaults to /data/{roadmap,preview-releases}.json inside the container,
# then falls back to the committed src/data/*.json bundled in the app so the
# pages always render.
#   Box:  /opt/cytweb-data/roadmap.json  +  /opt/cytweb-data/preview-releases.json
#   Run:  docker run ... -v /opt/cytweb-data:/data:ro \
#           -e ROADMAP_DATA_PATH=/data/roadmap.json \
#           -e RELEASES_DATA_PATH=/data/preview-releases.json ...
# ROADMAP_DATA_PATH=/data/roadmap.json
# RELEASES_DATA_PATH=/data/preview-releases.json
